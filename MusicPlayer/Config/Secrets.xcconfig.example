// Secrets.xcconfig.example — committed as documentation
// Copy to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is in .gitignore and must never be committed.

SPOTIFY_CLIENT_ID       = your_spotify_client_id_here
SOUNDCLOUD_CLIENT_ID    = your_soundcloud_client_id_here
BACKEND_API_KEY         = your_app_to_backend_key_here
