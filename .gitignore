!*.example
# Any file named secrets.* except .example templates
secrets.*
Secrets.*
!secrets.*.example
!Secrets.*.example
# Fastlane credentials
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
# Keystore / certificates with private keys
*.p12
*.mobileprovision

# macOS
.DS_Store
*.DS_Store
**/*.xcuserstate
